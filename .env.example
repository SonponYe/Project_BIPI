# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — module content generation, Twi/Pidgin localisation, AI career advisor.
# See Section 11 of the pitch (docs/ARCHITECTURE.md): the platform must degrade
# gracefully to pre-generated/static content if this is unavailable.
ANTHROPIC_API_KEY=

# Alternate AI providers (Scenario C fallback — swap behind lib/ai/claude.ts's interface)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maps (Ghana region boundary GeoJSON is bundled in src/content/geo/, Leaflet needs no token)
NEXT_PUBLIC_MAPBOX_TOKEN=

# SMS / USSD fallback for basic-phone users
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# Web Push (module reminders, streak alerts, badge notifications)
# Generate with `npx web-push generate-vapid-keys` — self-issued, no external account needed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bipi.app
